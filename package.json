{
  "name": "tl-support",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:firefox": "tsc --noEmit && TARGET=firefox vite build",
    "build:safari": "npm run build && xcrun safari-web-extension-converter dist --project-location dist-safari --app-name \"TL Support\" --macos-only --no-open --no-prompt --force",
    "test": "vitest run"
  },
  "dependencies": {
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
